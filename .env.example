# FloodLens-X local/demo environment. Copy to `.env` — never commit secrets.

# API
FLOODLENS_API_HOST=127.0.0.1
FLOODLENS_API_PORT=8000
FLOODLENS_DEMO_FIXTURES=1
# Extra CORS origins (comma-separated) in addition to localhost and floodlens-x.vercel.app
# FLOODLENS_CORS_ORIGINS=

# Frontend (Vite proxies /api to the API)
VITE_API_URL=

# Optional PostGIS (API runs without this via the in-memory store)
DATABASE_URL=postgresql://floodlens:floodlens@127.0.0.1:5432/floodlens

# Optional DEM
FLOODLENS_DEM_PATH=

# Optional OSM Overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional object storage (local artifact store is used if unset)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Identity is the demo IdP: Authorization: Bearer demo.<general|emergency|researcher|admin>
# Not a production OIDC configuration.
